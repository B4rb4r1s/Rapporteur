# Скопируйте в .env в корне репозитория: cp .env.example .env. Файл .env в git не входит.

# Адрес и порт интерфейса на хосте. По умолчанию только локальный адрес (spec §10).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# Хранилище приложения на хосте: база SQLite, оригиналы, кэш, справки. Путь относительно
# compose.yaml или абсолютный, только на файловой системе Linux (не /mnt/c на WSL).
RAPPORTEUR_STORAGE=./storage

# Ollama (ADR-010). Каталог, в котором лежат blobs/ и manifests/; для домашнего каталога
# Ollama (.ollama) — его подкаталог models. Ollama видит его только на чтение, поэтому
# каталог может принадлежать root или другому проекту. Скачать модель: make pull MODEL=…
OLLAMA_MODELS_DIR=/путь/к/каталогу/моделей
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m

# Ollama другого проекта вместо своей (docs/ollama.md): сеть Docker, в которой она работает,
# и её адрес в этой сети. Без OLLAMA_NETWORK запускается своя Ollama.
# OLLAMA_NETWORK=kgs_default
# OLLAMA_URL=http://ollama:11434
