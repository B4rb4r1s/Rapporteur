# Пример переменных окружения; секреты в git не хранятся. Пока у каждого сервиса свой compose,
# поэтому переменные экспортируются в окружение или кладутся в .env рядом с нужным compose.yaml.
# Общий .env и переменные базы данных добавит P1-01.

# web (backend/compose.yaml): адрес и порт на хосте. По умолчанию только локальный адрес (spec §10).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# Ollama (deploy/ollama/compose.yaml, ADR-010)
OLLAMA_MODELS_DIR=/путь/к/каталогу/моделей
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
