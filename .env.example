# Для make up: скопируйте в .env в корне репозитория. .env в git не входит.
# Отдельные compose каталогов по-прежнему читают .env рядом со своим compose.yaml.

# web (backend/compose.yaml): адрес и порт на хосте. По умолчанию только локальный адрес (spec §10).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000

# PostgreSQL (deploy/compose.yaml). Этот пароль — только для локальной разработки.
# При существующем томе смена значения здесь не меняет пароль в самой базе.
POSTGRES_DB=rapporteur
POSTGRES_USER=rapporteur
POSTGRES_PASSWORD=rapporteur-dev-only

# Необязательно: каталог для ручной постановки файлов через сервис cli, внутри — /input.
# Путь относительно deploy/compose.yaml; по умолчанию ../data (каталог data/ в корне).
# RAPPORTEUR_INPUT=/абсолютный/путь/к/материалам

# Владелец тома артефактов; на Linux можно задать результат id -u и id -g.
HOST_UID=1000
HOST_GID=1000

# Ollama (deploy/ollama/compose.yaml, ADR-010). Каталог, в котором лежат blobs/ и manifests/;
# для домашнего каталога Ollama (.ollama) — его подкаталог models. Сервис ollama видит его
# только на чтение, поэтому каталог может принадлежать root или другому проекту.
OLLAMA_MODELS_DIR=/путь/к/каталогу/моделей
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=5m
