{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "CheckName": {
      "enum": [
        "claim_links",
        "sentence_count",
        "numbers_in_sources",
        "forbidden_phrases",
        "critic"
      ],
      "title": "CheckName",
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "check": {
          "$ref": "#/$defs/CheckName"
        },
        "details": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "passed",
        "attempt",
        "details"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "Утверждение. key адресует его внутри сводки, id — в БД и API.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "pattern": "^c[1-9][0-9]*$",
          "title": "Key",
          "type": "string"
        },
        "rejected_evidence": {
          "items": {
            "$ref": "#/$defs/RejectedEvidence"
          },
          "title": "Rejected Evidence",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "key",
        "type",
        "text",
        "status",
        "evidence",
        "rejected_evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "description": "rejected — цитата не прошла сверку кодом; verified — прошла, человек ещё не смотрел;\nneeds_human — нужна проверка человеком: текст правили или опора только на текст VLM;\nconfirmed — подтверждено человеком.",
      "enum": [
        "rejected",
        "verified",
        "needs_human",
        "confirmed"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "problem",
        "method",
        "result",
        "conclusion",
        "listener_remark"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Подтверждённая ссылка. label и quote даёт модель, остальное вычисляет код (ADR-003).",
      "properties": {
        "fragment_revision_id": {
          "format": "uuid",
          "title": "Fragment Revision Id",
          "type": "string"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "label",
        "quote",
        "fragment_revision_id",
        "span",
        "match_score"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceDraft": {
      "additionalProperties": false,
      "description": "Ссылка от модели: метка и дословная цитата.",
      "properties": {
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "label",
        "quote"
      ],
      "title": "EvidenceDraft",
      "type": "object"
    },
    "EvidenceRejection": {
      "enum": [
        "label_not_found",
        "quote_not_found",
        "below_threshold",
        "number_mismatch",
        "negation_mismatch",
        "too_short"
      ],
      "title": "EvidenceRejection",
      "type": "string"
    },
    "FactDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceDraft"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "FactDraft",
      "type": "object"
    },
    "FactsDraft": {
      "additionalProperties": false,
      "description": "Ответ шага А. title, speakers и affiliations — подсказка для сверки с реестром.",
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "conclusions_absent_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conclusions Absent Reason"
        },
        "listener_remarks": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Listener Remarks",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Methods",
          "type": "array"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Results",
          "type": "array"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "talk_type": {
          "$ref": "#/$defs/TalkType"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "uncertain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Uncertain",
          "type": "array"
        }
      },
      "required": [
        "title",
        "speakers",
        "affiliations",
        "talk_type",
        "problem",
        "methods",
        "results",
        "conclusions",
        "conclusions_absent_reason",
        "listener_remarks",
        "uncertain"
      ],
      "title": "FactsDraft",
      "type": "object"
    },
    "RejectedEvidence": {
      "additionalProperties": false,
      "description": "Цитата, не прошедшая сверку, с причиной отказа.",
      "properties": {
        "best_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Best Score"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/EvidenceRejection"
        }
      },
      "required": [
        "label",
        "quote",
        "reason",
        "best_score"
      ],
      "title": "RejectedEvidence",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Сводка доклада: версия, утверждения, текст и результаты всех проверок.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "edited_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edited By"
        },
        "facts": {
          "$ref": "#/$defs/FactsDraft"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_revision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Input Revision Ids",
          "type": "array"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "prompt_versions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Sentences",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SummaryStatus"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "talk_id",
        "version",
        "status",
        "profile",
        "prompt_versions",
        "input_revision_ids",
        "facts",
        "claims",
        "sentences",
        "conclusions",
        "checks",
        "edited_by",
        "created_at"
      ],
      "title": "Summary",
      "type": "object"
    },
    "SummaryLine": {
      "additionalProperties": false,
      "description": "Предложение сводки или пункт выводов со ссылками на утверждения.",
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^c[1-9][0-9]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claim_ids"
      ],
      "title": "SummaryLine",
      "type": "object"
    },
    "SummaryStatus": {
      "enum": [
        "ready",
        "needs_attention",
        "stale"
      ],
      "title": "SummaryStatus",
      "type": "string"
    },
    "TalkType": {
      "enum": [
        "исследовательский",
        "обзорный",
        "прикладной",
        "иное"
      ],
      "title": "TalkType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "summary.json, шаги В и Г.",
  "properties": {
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "required": [
    "meta",
    "summary"
  ],
  "title": "SummaryArtifact",
  "type": "object",
  "version": "0.4.0"
}
