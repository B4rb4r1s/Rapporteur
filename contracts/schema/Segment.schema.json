{
  "$defs": {
    "SegmentKind": {
      "enum": [
        "talk",
        "qa",
        "service"
      ],
      "title": "SegmentKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Отрезок записи. Таймкоды абсолютные, от начала файла.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "confirmed": {
      "title": "Confirmed",
      "type": "boolean"
    },
    "end_ms": {
      "minimum": 0,
      "title": "End Ms",
      "type": "integer"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SegmentKind"
    },
    "source_file_id": {
      "format": "uuid",
      "title": "Source File Id",
      "type": "string"
    },
    "start_ms": {
      "minimum": 0,
      "title": "Start Ms",
      "type": "integer"
    },
    "talk_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Talk Id"
    }
  },
  "required": [
    "id",
    "source_file_id",
    "start_ms",
    "end_ms",
    "talk_id",
    "kind",
    "confidence",
    "confirmed"
  ],
  "title": "Segment",
  "type": "object",
  "version": "0.2.0"
}
