{
  "$defs": {
    "FragmentKind": {
      "enum": [
        "slide",
        "transcript",
        "note",
        "program",
        "slide_description"
      ],
      "title": "FragmentKind",
      "type": "string"
    },
    "LinesLocator": {
      "additionalProperties": false,
      "description": "Строки текстового файла, нумерация с единицы, конец включён.",
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "exclusiveMinimum": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "title": "LinesLocator",
      "type": "object"
    },
    "PackBlock": {
      "enum": [
        "main",
        "qa"
      ],
      "title": "PackBlock",
      "type": "string"
    },
    "PackedFragment": {
      "additionalProperties": false,
      "description": "Фрагмент в пакете доклада: метка и текст конкретной ревизии.",
      "properties": {
        "block": {
          "$ref": "#/$defs/PackBlock"
        },
        "fragment_id": {
          "format": "uuid",
          "title": "Fragment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "lines": "#/$defs/LinesLocator",
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "$ref": "#/$defs/LinesLocator"
            }
          ],
          "title": "Locator"
        },
        "low_quality": {
          "title": "Low Quality",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/TextOrigin"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "source_file_id": {
          "format": "uuid",
          "title": "Source File Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "kind",
        "fragment_id",
        "revision_id",
        "source_file_id",
        "locator",
        "origin",
        "text",
        "block",
        "low_quality"
      ],
      "title": "PackedFragment",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "description": "Слайд презентации или страница документа.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page_no": {
          "exclusiveMinimum": 0,
          "title": "Page No",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page_no"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "description": "Отрезок записи, таймкоды от начала файла.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "const": "time",
          "title": "Kind",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Все фрагменты ровно одного доклада: вход этапов сводки и единственное пространство\nпоиска цитат. Собирает воркер; цитата из другого доклада здесь не находится.",
  "properties": {
    "conference_id": {
      "format": "uuid",
      "title": "Conference Id",
      "type": "string"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/PackedFragment"
      },
      "title": "Fragments",
      "type": "array"
    },
    "talk_id": {
      "format": "uuid",
      "title": "Talk Id",
      "type": "string"
    }
  },
  "required": [
    "conference_id",
    "talk_id",
    "fragments"
  ],
  "title": "TalkFragmentPack",
  "type": "object",
  "version": "0.4.0"
}
