{
  "$defs": {
    "FileKind": {
      "enum": [
        "presentation",
        "audio",
        "video",
        "notes",
        "program"
      ],
      "title": "FileKind",
      "type": "string"
    },
    "HumanGate": {
      "enum": [
        "binding_confirmed",
        "boundaries_confirmed"
      ],
      "title": "HumanGate",
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "StageScope": {
      "enum": [
        "conference",
        "file",
        "talk"
      ],
      "title": "StageScope",
      "type": "string"
    },
    "StageSpec": {
      "additionalProperties": false,
      "description": "Этап конвейера. Этап с областью talk разворачивается в задачу на каждый доклад.\n\nfile_kinds — входные файлы этапа. Этап с областью file запускается на каждый файл этих\nвидов. Этап конференции с непустым списком нужен, только если такие файлы есть: без записей\nразбиение не запускается.",
      "properties": {
        "file_kinds": {
          "items": {
            "$ref": "#/$defs/FileKind"
          },
          "title": "File Kinds",
          "type": "array"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/HumanGate"
          },
          "title": "Gates",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "needs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "output": {
          "minLength": 1,
          "title": "Output",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/ResourceKind"
        },
        "scope": {
          "$ref": "#/$defs/StageScope"
        },
        "uses_llm": {
          "title": "Uses Llm",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "scope",
        "resource",
        "needs",
        "gates",
        "uses_llm",
        "output"
      ],
      "title": "StageSpec",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "stages": {
      "items": {
        "$ref": "#/$defs/StageSpec"
      },
      "title": "Stages",
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "stages"
  ],
  "title": "PipelineGraph",
  "type": "object",
  "version": "0.4.0"
}
