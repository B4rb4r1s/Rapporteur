{
  "$defs": {
    "CheckName": {
      "enum": [
        "claim_links",
        "sentence_count",
        "numbers_in_sources",
        "forbidden_phrases",
        "critic"
      ],
      "title": "CheckName",
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "check": {
          "$ref": "#/$defs/CheckName"
        },
        "details": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "passed",
        "attempt",
        "details"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "Утверждение. key адресует его внутри сводки, id — в БД и API.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "pattern": "^c[1-9][0-9]*$",
          "title": "Key",
          "type": "string"
        },
        "rejected_evidence": {
          "items": {
            "$ref": "#/$defs/RejectedEvidence"
          },
          "title": "Rejected Evidence",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "key",
        "type",
        "text",
        "status",
        "evidence",
        "rejected_evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "description": "rejected — цитата не прошла сверку кодом; verified — прошла, человек ещё не смотрел;\nneeds_human — нужна проверка человеком: текст правили или опора только на текст VLM;\nconfirmed — подтверждено человеком.",
      "enum": [
        "rejected",
        "verified",
        "needs_human",
        "confirmed"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "problem",
        "method",
        "result",
        "conclusion",
        "listener_remark"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Conference": {
      "additionalProperties": false,
      "description": "Конференция. Неизвестные сведения остаются пустыми (spec §4.2).",
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Date"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "organizer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organizer"
        },
        "owner_id": {
          "format": "uuid",
          "title": "Owner Id",
          "type": "string"
        },
        "place": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Place"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Date"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "owner_id",
        "title",
        "start_date",
        "end_date",
        "place",
        "organizer",
        "version"
      ],
      "title": "Conference",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Подтверждённая ссылка. label и quote даёт модель, остальное вычисляет код (ADR-003).",
      "properties": {
        "fragment_revision_id": {
          "format": "uuid",
          "title": "Fragment Revision Id",
          "type": "string"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "label",
        "quote",
        "fragment_revision_id",
        "span",
        "match_score"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceDraft": {
      "additionalProperties": false,
      "description": "Ссылка от модели: метка и дословная цитата.",
      "properties": {
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "label",
        "quote"
      ],
      "title": "EvidenceDraft",
      "type": "object"
    },
    "EvidenceRejection": {
      "enum": [
        "label_not_found",
        "quote_not_found",
        "below_threshold",
        "number_mismatch",
        "negation_mismatch",
        "too_short"
      ],
      "title": "EvidenceRejection",
      "type": "string"
    },
    "FactDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceDraft"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "FactDraft",
      "type": "object"
    },
    "FactsDraft": {
      "additionalProperties": false,
      "description": "Ответ шага А. title, speakers и affiliations — подсказка для сверки с реестром.",
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "conclusions_absent_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conclusions Absent Reason"
        },
        "listener_remarks": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Listener Remarks",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Methods",
          "type": "array"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Results",
          "type": "array"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "talk_type": {
          "$ref": "#/$defs/TalkType"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "uncertain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Uncertain",
          "type": "array"
        }
      },
      "required": [
        "title",
        "speakers",
        "affiliations",
        "talk_type",
        "problem",
        "methods",
        "results",
        "conclusions",
        "conclusions_absent_reason",
        "listener_remarks",
        "uncertain"
      ],
      "title": "FactsDraft",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "affiliation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affiliation"
        },
        "full_name": {
          "minLength": 1,
          "title": "Full Name",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "full_name",
        "affiliation"
      ],
      "title": "Person",
      "type": "object"
    },
    "PersonRole": {
      "enum": [
        "speaker",
        "coauthor"
      ],
      "title": "PersonRole",
      "type": "string"
    },
    "RejectedEvidence": {
      "additionalProperties": false,
      "description": "Цитата, не прошедшая сверку, с причиной отказа.",
      "properties": {
        "best_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Best Score"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/EvidenceRejection"
        }
      },
      "required": [
        "label",
        "quote",
        "reason",
        "best_score"
      ],
      "title": "RejectedEvidence",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "author_id": {
          "format": "uuid",
          "title": "Author Id",
          "type": "string"
        },
        "conference_id": {
          "format": "uuid",
          "title": "Conference Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ReportSelection"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "author_id",
        "conference_id",
        "selection",
        "template_version",
        "version"
      ],
      "title": "Report",
      "type": "object"
    },
    "ReportSelection": {
      "additionalProperties": false,
      "description": "talk_ids — итоговый список докладов; days и section_ids хранят выбор пользователя.",
      "properties": {
        "days": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "talk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Talk Ids",
          "type": "array"
        }
      },
      "required": [
        "days",
        "section_ids",
        "talk_ids"
      ],
      "title": "ReportSelection",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "description": "Секция. Дата — значение по умолчанию для её докладов.",
      "properties": {
        "conference_id": {
          "format": "uuid",
          "title": "Conference Id",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "hall": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hall"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "conference_id",
        "title",
        "date",
        "hall",
        "order"
      ],
      "title": "Section",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Сводка доклада: версия, утверждения, текст и результаты всех проверок.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "edited_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edited By"
        },
        "facts": {
          "$ref": "#/$defs/FactsDraft"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_revision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Input Revision Ids",
          "type": "array"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "prompt_versions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Sentences",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SummaryStatus"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "talk_id",
        "version",
        "status",
        "profile",
        "prompt_versions",
        "input_revision_ids",
        "facts",
        "claims",
        "sentences",
        "conclusions",
        "checks",
        "edited_by",
        "created_at"
      ],
      "title": "Summary",
      "type": "object"
    },
    "SummaryLine": {
      "additionalProperties": false,
      "description": "Предложение сводки или пункт выводов со ссылками на утверждения.",
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^c[1-9][0-9]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claim_ids"
      ],
      "title": "SummaryLine",
      "type": "object"
    },
    "SummaryStatus": {
      "enum": [
        "ready",
        "needs_attention",
        "stale"
      ],
      "title": "SummaryStatus",
      "type": "string"
    },
    "Talk": {
      "additionalProperties": false,
      "description": "Доклад реестра. Название и докладчики в справку идут отсюда, а не из ответа модели.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "match_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Match Confidence"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "participants": {
          "items": {
            "$ref": "#/$defs/TalkParticipant"
          },
          "title": "Participants",
          "type": "array"
        },
        "section_id": {
          "format": "uuid",
          "title": "Section Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TalkStatus"
        },
        "talk_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/TalkType"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "section_id",
        "order",
        "title",
        "date",
        "talk_type",
        "status",
        "match_confidence",
        "participants",
        "version"
      ],
      "title": "Talk",
      "type": "object"
    },
    "TalkParticipant": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "person_id": {
          "format": "uuid",
          "title": "Person Id",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/PersonRole"
        }
      },
      "required": [
        "person_id",
        "role",
        "order"
      ],
      "title": "TalkParticipant",
      "type": "object"
    },
    "TalkStatus": {
      "enum": [
        "draft",
        "matched",
        "processed",
        "reviewed",
        "stale",
        "not_held",
        "insufficient_data"
      ],
      "title": "TalkStatus",
      "type": "string"
    },
    "TalkType": {
      "enum": [
        "исследовательский",
        "обзорный",
        "прикладной",
        "иное"
      ],
      "title": "TalkType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Вход задачи report (ADR-013): снимок данных конференции на момент запроса сборки,\nвключая текущие сводки докладов, в том числе исправленные человеком.",
  "properties": {
    "conference": {
      "$ref": "#/$defs/Conference"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/Person"
      },
      "title": "People",
      "type": "array"
    },
    "report": {
      "$ref": "#/$defs/Report"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "title": "Sections",
      "type": "array"
    },
    "summaries": {
      "items": {
        "$ref": "#/$defs/Summary"
      },
      "title": "Summaries",
      "type": "array"
    },
    "talks": {
      "items": {
        "$ref": "#/$defs/Talk"
      },
      "title": "Talks",
      "type": "array"
    },
    "unreviewed_confirmed": {
      "title": "Unreviewed Confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "report",
    "conference",
    "sections",
    "talks",
    "people",
    "summaries",
    "unreviewed_confirmed"
  ],
  "title": "ReportRequest",
  "type": "object",
  "version": "0.5.0"
}
