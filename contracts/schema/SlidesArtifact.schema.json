{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "FragmentDraft": {
      "additionalProperties": false,
      "description": "Кэшируемый фрагмент: только файл и локатор, без UUID и меток, поэтому артефакт\nпереиспользуется между конференциями. Текст слайда включает заметки докладчика.",
      "properties": {
        "engine_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Engine Confidence"
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "lines": "#/$defs/LinesLocator",
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "$ref": "#/$defs/LinesLocator"
            }
          ],
          "title": "Locator"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/TextOrigin"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_sha256",
        "locator",
        "raw_text",
        "normalized_text",
        "origin",
        "engine_confidence"
      ],
      "title": "FragmentDraft",
      "type": "object"
    },
    "FragmentKind": {
      "enum": [
        "slide",
        "transcript",
        "note",
        "program",
        "slide_description"
      ],
      "title": "FragmentKind",
      "type": "string"
    },
    "LinesLocator": {
      "additionalProperties": false,
      "description": "Строки текстового файла, нумерация с единицы, конец включён.",
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "exclusiveMinimum": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "title": "LinesLocator",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "description": "Слайд презентации или страница документа.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page_no": {
          "exclusiveMinimum": 0,
          "title": "Page No",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page_no"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "SlideRecord": {
      "additionalProperties": false,
      "properties": {
        "has_text": {
          "title": "Has Text",
          "type": "boolean"
        },
        "image_path": {
          "minLength": 1,
          "title": "Image Path",
          "type": "string"
        },
        "is_conclusion": {
          "title": "Is Conclusion",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "slide_no": {
          "exclusiveMinimum": 0,
          "title": "Slide No",
          "type": "integer"
        },
        "tables": {
          "items": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Tables",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "vlm_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vlm Description"
        }
      },
      "required": [
        "slide_no",
        "title",
        "text",
        "tables",
        "notes",
        "image_path",
        "vlm_description",
        "is_conclusion",
        "has_text"
      ],
      "title": "SlideRecord",
      "type": "object"
    },
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "description": "Отрезок записи, таймкоды от начала файла.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "const": "time",
          "title": "Kind",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "TimeLocator",
      "type": "object"
    },
    "TitleCandidates": {
      "additionalProperties": false,
      "description": "Кандидаты с титульного слайда. Пустое поле означает «не найдено».",
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        }
      },
      "required": [
        "title",
        "speakers",
        "affiliations"
      ],
      "title": "TitleCandidates",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "slides.json, этап 6.2, один файл презентации.",
  "properties": {
    "dictionary": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Dictionary",
      "type": "array"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/FragmentDraft"
      },
      "title": "Fragments",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideRecord"
      },
      "title": "Slides",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "title_candidates": {
      "$ref": "#/$defs/TitleCandidates"
    }
  },
  "required": [
    "meta",
    "source_sha256",
    "slides",
    "title_candidates",
    "dictionary",
    "fragments"
  ],
  "title": "SlidesArtifact",
  "type": "object",
  "version": "0.4.0"
}
