{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Привязка файла. talk_id пуст, если файл относится к конференции целиком.",
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "confirmed": {
      "title": "Confirmed",
      "type": "boolean"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "source_file_id": {
      "format": "uuid",
      "title": "Source File Id",
      "type": "string"
    },
    "talk_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Talk Id"
    }
  },
  "required": [
    "id",
    "source_file_id",
    "talk_id",
    "confirmed",
    "confidence"
  ],
  "title": "FileBinding",
  "type": "object",
  "version": "0.3.0"
}
