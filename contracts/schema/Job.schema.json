{
  "$defs": {
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "retry_wait",
        "cancel_requested"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "ResourceKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Задача очереди (ADR-004). Ожидание проверки человеком статусом не является (ADR-009).",
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "conference_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conference Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_step": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Step"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Heartbeat At"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "lease_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Lease Until"
    },
    "priority": {
      "title": "Priority",
      "type": "integer"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Progress"
    },
    "resource": {
      "$ref": "#/$defs/ResourceKind"
    },
    "stage": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stage"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "talk_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Talk Id"
    },
    "type": {
      "minLength": 1,
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "stage",
    "conference_id",
    "talk_id",
    "resource",
    "status",
    "priority",
    "attempt",
    "lease_until",
    "heartbeat_at",
    "progress",
    "current_step",
    "error_code",
    "created_at"
  ],
  "title": "Job",
  "type": "object",
  "version": "0.2.0"
}
