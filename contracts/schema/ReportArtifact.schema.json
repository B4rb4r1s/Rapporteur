{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "ReportFile": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ReportFormat"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "format",
        "storage_key",
        "sha256",
        "size_bytes"
      ],
      "title": "ReportFile",
      "type": "object"
    },
    "ReportFormat": {
      "enum": [
        "md",
        "docx",
        "pdf"
      ],
      "title": "ReportFormat",
      "type": "string"
    },
    "ReportInput": {
      "additionalProperties": false,
      "description": "Снимок входных данных сборки. Хранится в версии справки.",
      "properties": {
        "conference_title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conference Title"
        },
        "organizer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organizer"
        },
        "period_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period End"
        },
        "period_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period Start"
        },
        "place": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Place"
        },
        "selection": {
          "$ref": "#/$defs/ReportSelection"
        },
        "skipped": {
          "items": {
            "$ref": "#/$defs/SkippedTalk"
          },
          "title": "Skipped",
          "type": "array"
        },
        "talks": {
          "items": {
            "$ref": "#/$defs/ReportTalk"
          },
          "title": "Talks",
          "type": "array"
        },
        "template_version": {
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        },
        "unreviewed_confirmed": {
          "title": "Unreviewed Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "conference_title",
        "period_start",
        "period_end",
        "place",
        "organizer",
        "selection",
        "talks",
        "skipped",
        "template_version",
        "unreviewed_confirmed"
      ],
      "title": "ReportInput",
      "type": "object"
    },
    "ReportSelection": {
      "additionalProperties": false,
      "description": "talk_ids — итоговый список докладов; days и section_ids хранят выбор пользователя.",
      "properties": {
        "days": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Days",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        },
        "talk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Talk Ids",
          "type": "array"
        }
      },
      "required": [
        "days",
        "section_ids",
        "talk_ids"
      ],
      "title": "ReportSelection",
      "type": "object"
    },
    "ReportTalk": {
      "additionalProperties": false,
      "description": "Доклад в справке. Название и докладчики — из реестра, текст — из сводки.",
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "section_title": {
          "minLength": 1,
          "title": "Section Title",
          "type": "string"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/TalkStatus"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "talk_id",
        "section_title",
        "title",
        "speakers",
        "affiliations",
        "status",
        "summary",
        "conclusions"
      ],
      "title": "ReportTalk",
      "type": "object"
    },
    "ReportVariables": {
      "additionalProperties": false,
      "description": "Значения, которые считает код, а не модель.",
      "properties": {
        "speakers_count": {
          "minimum": 0,
          "title": "Speakers Count",
          "type": "integer"
        },
        "talks_count": {
          "minimum": 0,
          "title": "Talks Count",
          "type": "integer"
        }
      },
      "required": [
        "talks_count",
        "speakers_count"
      ],
      "title": "ReportVariables",
      "type": "object"
    },
    "SkippedTalk": {
      "additionalProperties": false,
      "description": "Выбранный доклад, который не вошёл в справку. Показывается пользователю.",
      "properties": {
        "status": {
          "$ref": "#/$defs/TalkStatus"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        }
      },
      "required": [
        "talk_id",
        "title",
        "status"
      ],
      "title": "SkippedTalk",
      "type": "object"
    },
    "TalkStatus": {
      "enum": [
        "draft",
        "matched",
        "processed",
        "reviewed",
        "stale",
        "not_held",
        "insufficient_data"
      ],
      "title": "TalkStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Выдача задачи report. input, variables и files переходят в ReportVersion (ADR-013).",
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/ReportFile"
      },
      "title": "Files",
      "type": "array"
    },
    "input": {
      "$ref": "#/$defs/ReportInput"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "variables": {
      "$ref": "#/$defs/ReportVariables"
    }
  },
  "required": [
    "meta",
    "report_id",
    "input",
    "variables",
    "files"
  ],
  "title": "ReportArtifact",
  "type": "object",
  "version": "0.4.0"
}
