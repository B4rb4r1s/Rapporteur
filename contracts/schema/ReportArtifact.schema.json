{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "ReportFile": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/ReportFormat"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "format",
        "storage_key",
        "sha256",
        "size_bytes"
      ],
      "title": "ReportFile",
      "type": "object"
    },
    "ReportFormat": {
      "enum": [
        "md",
        "docx",
        "pdf"
      ],
      "title": "ReportFormat",
      "type": "string"
    },
    "ReportVariables": {
      "additionalProperties": false,
      "description": "Значения, которые считает код, а не модель.",
      "properties": {
        "speakers_count": {
          "minimum": 0,
          "title": "Speakers Count",
          "type": "integer"
        },
        "talks_count": {
          "minimum": 0,
          "title": "Talks Count",
          "type": "integer"
        }
      },
      "required": [
        "talks_count",
        "speakers_count"
      ],
      "title": "ReportVariables",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Выдача сборки справки.",
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/ReportFile"
      },
      "title": "Files",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "report_id": {
      "format": "uuid",
      "title": "Report Id",
      "type": "string"
    },
    "variables": {
      "$ref": "#/$defs/ReportVariables"
    }
  },
  "required": [
    "meta",
    "report_id",
    "variables",
    "files"
  ],
  "title": "ReportArtifact",
  "type": "object",
  "version": "0.3.0"
}
