{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "FragmentKind": {
      "enum": [
        "slide",
        "transcript",
        "note",
        "program",
        "slide_description"
      ],
      "title": "FragmentKind",
      "type": "string"
    },
    "LinesLocator": {
      "additionalProperties": false,
      "description": "Строки текстового файла, нумерация с единицы, конец включён.",
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "exclusiveMinimum": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "title": "LinesLocator",
      "type": "object"
    },
    "PackBlock": {
      "enum": [
        "main",
        "qa"
      ],
      "title": "PackBlock",
      "type": "string"
    },
    "PackedFragment": {
      "additionalProperties": false,
      "description": "Фрагмент в пакете доклада: метка и текст конкретной ревизии.",
      "properties": {
        "block": {
          "$ref": "#/$defs/PackBlock"
        },
        "fragment_id": {
          "format": "uuid",
          "title": "Fragment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "lines": "#/$defs/LinesLocator",
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "$ref": "#/$defs/LinesLocator"
            }
          ],
          "title": "Locator"
        },
        "low_quality": {
          "title": "Low Quality",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/TextOrigin"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "source_file_id": {
          "format": "uuid",
          "title": "Source File Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "kind",
        "fragment_id",
        "revision_id",
        "source_file_id",
        "locator",
        "origin",
        "text",
        "block",
        "low_quality"
      ],
      "title": "PackedFragment",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "description": "Слайд презентации или страница документа.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page_no": {
          "exclusiveMinimum": 0,
          "title": "Page No",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page_no"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "TalkFragmentPack": {
      "additionalProperties": false,
      "description": "Все фрагменты ровно одного доклада: вход этапов сводки и единственное пространство\nпоиска цитат. Собирает воркер; цитата из другого доклада здесь не находится.",
      "properties": {
        "conference_id": {
          "format": "uuid",
          "title": "Conference Id",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/PackedFragment"
          },
          "title": "Fragments",
          "type": "array"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        }
      },
      "required": [
        "conference_id",
        "talk_id",
        "fragments"
      ],
      "title": "TalkFragmentPack",
      "type": "object"
    },
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "description": "Отрезок записи, таймкоды от начала файла.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "const": "time",
          "title": "Kind",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "pack.json: пакет фрагментов одного доклада, общий вход шагов сводки (ADR-013).",
  "properties": {
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "pack": {
      "$ref": "#/$defs/TalkFragmentPack"
    }
  },
  "required": [
    "meta",
    "pack"
  ],
  "title": "PackArtifact",
  "type": "object",
  "version": "0.5.0"
}
