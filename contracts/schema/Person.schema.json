{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affiliation": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Affiliation"
    },
    "full_name": {
      "minLength": 1,
      "title": "Full Name",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "full_name",
    "affiliation"
  ],
  "title": "Person",
  "type": "object",
  "version": "0.5.0"
}
