{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_key": {
          "minLength": 1,
          "title": "Storage Key",
          "type": "string"
        }
      },
      "required": [
        "name",
        "storage_key",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "warnings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "artifact",
    "meta",
    "warnings"
  ],
  "title": "StageOutput",
  "type": "object",
  "version": "0.4.0"
}
