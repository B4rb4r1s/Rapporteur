{
  "$defs": {
    "EvidenceDraft": {
      "additionalProperties": false,
      "description": "Ссылка от модели: метка и дословная цитата.",
      "properties": {
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "label",
        "quote"
      ],
      "title": "EvidenceDraft",
      "type": "object"
    },
    "FactDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceDraft"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "FactDraft",
      "type": "object"
    },
    "TalkType": {
      "enum": [
        "исследовательский",
        "обзорный",
        "прикладной",
        "иное"
      ],
      "title": "TalkType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Ответ шага А. title, speakers и affiliations — подсказка для сверки с реестром.",
  "properties": {
    "affiliations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Affiliations",
      "type": "array"
    },
    "conclusions": {
      "items": {
        "$ref": "#/$defs/FactDraft"
      },
      "title": "Conclusions",
      "type": "array"
    },
    "conclusions_absent_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Conclusions Absent Reason"
    },
    "listener_remarks": {
      "items": {
        "$ref": "#/$defs/FactDraft"
      },
      "title": "Listener Remarks",
      "type": "array"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/FactDraft"
      },
      "title": "Methods",
      "type": "array"
    },
    "problem": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "results": {
      "items": {
        "$ref": "#/$defs/FactDraft"
      },
      "title": "Results",
      "type": "array"
    },
    "speakers": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Speakers",
      "type": "array"
    },
    "talk_type": {
      "$ref": "#/$defs/TalkType"
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    },
    "uncertain": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Uncertain",
      "type": "array"
    }
  },
  "required": [
    "title",
    "speakers",
    "affiliations",
    "talk_type",
    "problem",
    "methods",
    "results",
    "conclusions",
    "conclusions_absent_reason",
    "listener_remarks",
    "uncertain"
  ],
  "title": "FactsDraft",
  "type": "object",
  "version": "0.3.0"
}
