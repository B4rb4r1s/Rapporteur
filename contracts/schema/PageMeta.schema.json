{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Пагинация списков: тело ответа — {items: [...], page: PageMeta}.",
  "properties": {
    "limit": {
      "exclusiveMinimum": 0,
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "total",
    "limit",
    "offset"
  ],
  "title": "PageMeta",
  "type": "object",
  "version": "0.4.0"
}
