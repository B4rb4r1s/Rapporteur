{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "FileFailure": {
      "additionalProperties": false,
      "description": "Ошибка одного файла не скрывает результаты остальных (spec §6).",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "original_name": {
          "minLength": 1,
          "title": "Original Name",
          "type": "string"
        }
      },
      "required": [
        "original_name",
        "code",
        "message"
      ],
      "title": "FileFailure",
      "type": "object"
    },
    "FileKind": {
      "enum": [
        "presentation",
        "audio",
        "video",
        "notes",
        "program"
      ],
      "title": "FileKind",
      "type": "string"
    },
    "InventoryItem": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Ms"
        },
        "encoding": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Encoding"
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "original_name": {
          "minLength": 1,
          "title": "Original Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "original_name",
        "kind",
        "media_type",
        "size_bytes",
        "duration_ms",
        "encoding"
      ],
      "title": "InventoryItem",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "inventory.json, этап 6.1.",
  "properties": {
    "failures": {
      "items": {
        "$ref": "#/$defs/FileFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/InventoryItem"
      },
      "title": "Files",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    }
  },
  "required": [
    "meta",
    "files",
    "failures"
  ],
  "title": "InventoryArtifact",
  "type": "object",
  "version": "0.1.0"
}
