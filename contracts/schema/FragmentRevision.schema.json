{
  "$defs": {
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Неизменяемая версия текста. normalized_text — отображаемый текст: регистр, пунктуация,\nчисла и ё сохранены; span считается по нему.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "edited_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Edited By"
    },
    "fragment_id": {
      "format": "uuid",
      "title": "Fragment Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "normalized_text": {
      "title": "Normalized Text",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/TextOrigin"
    },
    "raw_text": {
      "title": "Raw Text",
      "type": "string"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "fragment_id",
    "revision",
    "raw_text",
    "normalized_text",
    "origin",
    "edited_by",
    "created_at"
  ],
  "title": "FragmentRevision",
  "type": "object",
  "version": "0.5.0"
}
