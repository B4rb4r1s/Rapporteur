{
  "$defs": {
    "ArtifactMeta": {
      "additionalProperties": false,
      "description": "Служебная часть каждого артефакта. stub явно помечает результат заглушки (spec §17).",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "contract_version": {
          "minLength": 1,
          "title": "Contract Version",
          "type": "string"
        },
        "input_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "array"
        },
        "produced_at": {
          "format": "date-time",
          "title": "Produced At",
          "type": "string"
        },
        "stage": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stage",
          "type": "string"
        },
        "stage_version": {
          "minLength": 1,
          "title": "Stage Version",
          "type": "string"
        },
        "stub": {
          "title": "Stub",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "stage_version",
        "contract_version",
        "cache_key",
        "input_hashes",
        "config_hash",
        "produced_at",
        "stub"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "FragmentDraft": {
      "additionalProperties": false,
      "description": "Кэшируемый фрагмент: только файл и локатор, без UUID и меток, поэтому артефакт\nпереиспользуется между конференциями. Текст слайда включает заметки докладчика.",
      "properties": {
        "engine_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Engine Confidence"
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "lines": "#/$defs/LinesLocator",
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "$ref": "#/$defs/LinesLocator"
            }
          ],
          "title": "Locator"
        },
        "normalized_text": {
          "title": "Normalized Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/TextOrigin"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source_sha256",
        "locator",
        "raw_text",
        "normalized_text",
        "origin",
        "engine_confidence"
      ],
      "title": "FragmentDraft",
      "type": "object"
    },
    "FragmentKind": {
      "enum": [
        "slide",
        "transcript",
        "note",
        "program",
        "slide_description"
      ],
      "title": "FragmentKind",
      "type": "string"
    },
    "LinesLocator": {
      "additionalProperties": false,
      "description": "Строки текстового файла, нумерация с единицы, конец включён.",
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "exclusiveMinimum": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "title": "LinesLocator",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "description": "Слайд презентации или страница документа.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page_no": {
          "exclusiveMinimum": 0,
          "title": "Page No",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page_no"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "description": "Отрезок записи, таймкоды от начала файла.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "const": "time",
          "title": "Kind",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "TimeLocator",
      "type": "object"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "low_quality": {
          "title": "Low Quality",
          "type": "boolean"
        },
        "speaker": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Speaker"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text",
        "confidence",
        "speaker",
        "low_quality",
        "words"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "TranscriptWord": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "text",
        "confidence"
      ],
      "title": "TranscriptWord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "transcript.json, этап 6.4. Таймкоды абсолютные, от начала исходного файла.",
  "properties": {
    "engine": {
      "minLength": 1,
      "title": "Engine",
      "type": "string"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/FragmentDraft"
      },
      "title": "Fragments",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "source_sha256",
    "engine",
    "segments",
    "fragments"
  ],
  "title": "TranscriptArtifact",
  "type": "object",
  "version": "0.3.0"
}
