{
  "$defs": {
    "RegistryAudio": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
          "title": "End",
          "type": "string"
        },
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "start": {
          "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start",
        "end"
      ],
      "title": "RegistryAudio",
      "type": "object"
    },
    "RegistryConference": {
      "additionalProperties": false,
      "properties": {
        "dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "maxItems": 2,
          "title": "Dates",
          "type": "array"
        },
        "place": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Place"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "RegistryConference",
      "type": "object"
    },
    "RegistrySection": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "RegistrySection",
      "type": "object"
    },
    "RegistrySources": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "items": {
            "$ref": "#/$defs/RegistryAudio"
          },
          "title": "Audio",
          "type": "array"
        },
        "notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "slides": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Slides",
          "type": "array"
        }
      },
      "title": "RegistrySources",
      "type": "object"
    },
    "RegistryTalk": {
      "additionalProperties": false,
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "coauthors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Coauthors",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "order": {
          "exclusiveMinimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "section": {
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "sources": {
          "$ref": "#/$defs/RegistrySources"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/TalkStatus"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "section",
        "order",
        "sources",
        "status"
      ],
      "title": "RegistryTalk",
      "type": "object"
    },
    "TalkStatus": {
      "enum": [
        "draft",
        "matched",
        "processed",
        "reviewed",
        "stale",
        "not_held",
        "insufficient_data"
      ],
      "title": "TalkStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conference": {
      "$ref": "#/$defs/RegistryConference"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/RegistrySection"
      },
      "title": "Sections",
      "type": "array"
    },
    "talks": {
      "items": {
        "$ref": "#/$defs/RegistryTalk"
      },
      "title": "Talks",
      "type": "array"
    }
  },
  "required": [
    "conference",
    "sections",
    "talks"
  ],
  "title": "ConferenceRegistry",
  "type": "object",
  "version": "0.1.0"
}
