{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Секция. Дата — значение по умолчанию для её докладов.",
  "properties": {
    "conference_id": {
      "format": "uuid",
      "title": "Conference Id",
      "type": "string"
    },
    "date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Date"
    },
    "hall": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Hall"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "order": {
      "exclusiveMinimum": 0,
      "title": "Order",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "conference_id",
    "title",
    "date",
    "hall",
    "order"
  ],
  "title": "Section",
  "type": "object",
  "version": "0.2.0"
}
