{
  "$defs": {
    "CheckName": {
      "enum": [
        "claim_links",
        "sentence_count",
        "numbers_in_sources",
        "forbidden_phrases",
        "critic"
      ],
      "title": "CheckName",
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "exclusiveMinimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "check": {
          "$ref": "#/$defs/CheckName"
        },
        "details": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "check",
        "passed",
        "attempt",
        "details"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "Утверждение. key адресует его внутри сводки, id — в БД и API.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "pattern": "^c[1-9][0-9]*$",
          "title": "Key",
          "type": "string"
        },
        "rejected_evidence": {
          "items": {
            "$ref": "#/$defs/RejectedEvidence"
          },
          "title": "Rejected Evidence",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ClaimType"
        }
      },
      "required": [
        "id",
        "key",
        "type",
        "text",
        "status",
        "evidence",
        "rejected_evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "description": "rejected — цитата не прошла сверку кодом; verified — прошла, человек ещё не смотрел;\nneeds_human — нужна проверка человеком: текст правили или опора только на текст VLM;\nconfirmed — подтверждено человеком.",
      "enum": [
        "rejected",
        "verified",
        "needs_human",
        "confirmed"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "problem",
        "method",
        "result",
        "conclusion",
        "listener_remark"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Подтверждённая ссылка. label и quote даёт модель, остальное вычисляет код (ADR-003).",
      "properties": {
        "fragment_revision_id": {
          "format": "uuid",
          "title": "Fragment Revision Id",
          "type": "string"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "match_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Span",
          "type": "array"
        }
      },
      "required": [
        "label",
        "quote",
        "fragment_revision_id",
        "span",
        "match_score"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceDraft": {
      "additionalProperties": false,
      "description": "Ссылка от модели: метка и дословная цитата.",
      "properties": {
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "label",
        "quote"
      ],
      "title": "EvidenceDraft",
      "type": "object"
    },
    "EvidenceRejection": {
      "enum": [
        "label_not_found",
        "quote_not_found",
        "below_threshold",
        "number_mismatch",
        "negation_mismatch",
        "too_short"
      ],
      "title": "EvidenceRejection",
      "type": "string"
    },
    "FactDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceDraft"
          },
          "title": "Evidence",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "evidence"
      ],
      "title": "FactDraft",
      "type": "object"
    },
    "FactsDraft": {
      "additionalProperties": false,
      "description": "Ответ шага А. title, speakers и affiliations — подсказка для сверки с реестром.",
      "properties": {
        "affiliations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affiliations",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "conclusions_absent_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Conclusions Absent Reason"
        },
        "listener_remarks": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Listener Remarks",
          "type": "array"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Methods",
          "type": "array"
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactDraft"
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/FactDraft"
          },
          "title": "Results",
          "type": "array"
        },
        "speakers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Speakers",
          "type": "array"
        },
        "talk_type": {
          "$ref": "#/$defs/TalkType"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "uncertain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Uncertain",
          "type": "array"
        }
      },
      "required": [
        "title",
        "speakers",
        "affiliations",
        "talk_type",
        "problem",
        "methods",
        "results",
        "conclusions",
        "conclusions_absent_reason",
        "listener_remarks",
        "uncertain"
      ],
      "title": "FactsDraft",
      "type": "object"
    },
    "FragmentKind": {
      "enum": [
        "slide",
        "transcript",
        "note",
        "program",
        "slide_description"
      ],
      "title": "FragmentKind",
      "type": "string"
    },
    "LinesLocator": {
      "additionalProperties": false,
      "description": "Строки текстового файла, нумерация с единицы, конец включён.",
      "properties": {
        "kind": {
          "const": "lines",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "exclusiveMinimum": 0,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "exclusiveMinimum": 0,
          "title": "Line Start",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "title": "LinesLocator",
      "type": "object"
    },
    "PackBlock": {
      "enum": [
        "main",
        "qa"
      ],
      "title": "PackBlock",
      "type": "string"
    },
    "PackedFragment": {
      "additionalProperties": false,
      "description": "Фрагмент в пакете доклада: метка и текст конкретной ревизии.",
      "properties": {
        "block": {
          "$ref": "#/$defs/PackBlock"
        },
        "fragment_id": {
          "format": "uuid",
          "title": "Fragment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "lines": "#/$defs/LinesLocator",
              "page": "#/$defs/PageLocator",
              "time": "#/$defs/TimeLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PageLocator"
            },
            {
              "$ref": "#/$defs/TimeLocator"
            },
            {
              "$ref": "#/$defs/LinesLocator"
            }
          ],
          "title": "Locator"
        },
        "low_quality": {
          "title": "Low Quality",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/TextOrigin"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "source_file_id": {
          "format": "uuid",
          "title": "Source File Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "kind",
        "fragment_id",
        "revision_id",
        "source_file_id",
        "locator",
        "origin",
        "text",
        "block",
        "low_quality"
      ],
      "title": "PackedFragment",
      "type": "object"
    },
    "PageLocator": {
      "additionalProperties": false,
      "description": "Слайд презентации или страница документа.",
      "properties": {
        "kind": {
          "const": "page",
          "title": "Kind",
          "type": "string"
        },
        "page_no": {
          "exclusiveMinimum": 0,
          "title": "Page No",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page_no"
      ],
      "title": "PageLocator",
      "type": "object"
    },
    "RejectedEvidence": {
      "additionalProperties": false,
      "description": "Цитата, не прошедшая сверку, с причиной отказа.",
      "properties": {
        "best_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Best Score"
        },
        "label": {
          "pattern": "^(?:[SV](?:[1-9][0-9]*\\.)?[1-9][0-9]*|T(?:[1-9][0-9]*\\.)?[0-9]{2}:[0-9]{2}:[0-9]{2}|N[1-9][0-9]*)$",
          "title": "Label",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/EvidenceRejection"
        }
      },
      "required": [
        "label",
        "quote",
        "reason",
        "best_score"
      ],
      "title": "RejectedEvidence",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Сводка доклада: версия, утверждения, текст и результаты всех проверок.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "conclusions": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Conclusions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "edited_by": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edited By"
        },
        "facts": {
          "$ref": "#/$defs/FactsDraft"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_revision_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Input Revision Ids",
          "type": "array"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "prompt_versions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/SummaryLine"
          },
          "title": "Sentences",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/SummaryStatus"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "talk_id",
        "version",
        "status",
        "profile",
        "prompt_versions",
        "input_revision_ids",
        "facts",
        "claims",
        "sentences",
        "conclusions",
        "checks",
        "edited_by",
        "created_at"
      ],
      "title": "Summary",
      "type": "object"
    },
    "SummaryLine": {
      "additionalProperties": false,
      "description": "Предложение сводки или пункт выводов со ссылками на утверждения.",
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^c[1-9][0-9]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claim_ids"
      ],
      "title": "SummaryLine",
      "type": "object"
    },
    "SummaryStatus": {
      "enum": [
        "ready",
        "needs_attention",
        "stale"
      ],
      "title": "SummaryStatus",
      "type": "string"
    },
    "TalkFragmentPack": {
      "additionalProperties": false,
      "description": "Все фрагменты ровно одного доклада: вход этапов сводки и единственное пространство\nпоиска цитат. Собирает воркер; цитата из другого доклада здесь не находится.",
      "properties": {
        "conference_id": {
          "format": "uuid",
          "title": "Conference Id",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/PackedFragment"
          },
          "title": "Fragments",
          "type": "array"
        },
        "talk_id": {
          "format": "uuid",
          "title": "Talk Id",
          "type": "string"
        }
      },
      "required": [
        "conference_id",
        "talk_id",
        "fragments"
      ],
      "title": "TalkFragmentPack",
      "type": "object"
    },
    "TalkType": {
      "enum": [
        "исследовательский",
        "обзорный",
        "прикладной",
        "иное"
      ],
      "title": "TalkType",
      "type": "string"
    },
    "TextOrigin": {
      "enum": [
        "extracted",
        "asr",
        "vlm",
        "term_fix",
        "human"
      ],
      "title": "TextOrigin",
      "type": "string"
    },
    "TimeLocator": {
      "additionalProperties": false,
      "description": "Отрезок записи, таймкоды от начала файла.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "kind": {
          "const": "time",
          "title": "Kind",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "TimeLocator",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Сводка вместе с пакетом, по которому она собрана. Здесь проверяются правила,\nкоторые JSON Schema не выражает. Воркер строит этот объект до публикации результата.",
  "properties": {
    "pack": {
      "$ref": "#/$defs/TalkFragmentPack"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    }
  },
  "required": [
    "pack",
    "summary"
  ],
  "title": "TalkSummaryBundle",
  "type": "object",
  "version": "0.5.0"
}
